#include <stdio.h>
#include <stdlib.h>
#include <time.h>

struct Cliente {
    char nome[30], historico[100];
    float saldo[3];
    int conta[3], numero[3], titulo, emprestimo;
};

float total(struct Cliente c) {
    return c.saldo[0] + c.saldo[1] + c.saldo[2];
}

int main() {
    struct Cliente c[50];
    int n, i, j, op, acao, tipo, id, aberto = 0;
    int num = 1000, ordem[50], a, b, temp;
    float valor, limite, premio;

    srand(time(NULL));

    printf("Quantidade de clientes: ");
    scanf("%d", &n);

    if(n < 1 || n > 50) return 0;

    for(i = 0; i < n; i++) {
        printf("\nNome: ");
        scanf("%29s", c[i].nome);

        c[i].titulo = c[i].emprestimo = 0;
        c[i].historico[0] = '\0';

        for(j = 0; j < 3; j++) {
            c[i].saldo[j] = 0;
            c[i].conta[j] = 0;
            c[i].numero[j] = 0;
        }

        printf("Corrente (1/0): ");
        scanf("%d", &c[i].conta[0]);

        printf("Salario (1/0): ");
        scanf("%d", &c[i].conta[1]);

        if(c[i].conta[0] && c[i].conta[1]) {
            printf("Contas nao permitidas!\n");
            c[i].conta[1] = 0;
        }

        printf("Poupanca (1/0): ");
        scanf("%d", &c[i].conta[2]);

        for(j = 0; j < 3; j++)
            if(c[i].conta[j])
                c[i].numero[j] = num++;
    }

    do {
        for(i = 0; i < n; i++)
            if(c[i].saldo[0] < 0)
                printf("\nALERTA: %s tem saldo negativo!\n", c[i].nome);

        printf("\n=== BANCO ===\n");
        printf("1-Abrir banco\n2-Historico\n3-Sorteio\n0-Sair\n");
        scanf("%d", &op);

        switch(op) {
        case 1:
            aberto = 1;
            do {
                printf("\n1-Deposito 2-Saque 3-Emprestimo");
                printf("\n4-Titulo 0-Voltar\n");
                scanf("%d", &acao);

                if(acao >= 1 && acao <= 4) {
                    printf("Cliente (1 a %d): ", n);
                    scanf("%d", &id);
                    id--;

                    if(id < 0 || id >= n) {
                        printf("Cliente invalido!\n");
                        continue;
                    }

                    if(acao <= 2) {
                        printf("Conta (1-Corrente 2-Salario 3-Poupanca): ");
                        scanf("%d", &tipo);
                        tipo--;

                        if(tipo < 0 || tipo > 2 || !c[id].conta[tipo]) {
                            printf("Conta inexistente!\n");
                            continue;
                        }

                        printf("Valor: ");
                        scanf("%f", &valor);

                        if(valor > 0) {
                            if(acao == 1) {
                                c[id].saldo[tipo] += valor;
                                sprintf(c[id].historico, "Deposito");
                            } else {
                                c[id].saldo[tipo] -= valor;
                                sprintf(c[id].historico, "Saque");
                            }
                        }
                    }

                    else if(acao == 3) {
                        limite = total(c[id]) * 2.5;

                        if(c[id].conta[0] && c[id].conta[2] &&
                           c[id].saldo[2] > 0 && !c[id].emprestimo &&
                           limite > 0) {

                            printf("Limite: R$ %.2f\nValor: ", limite);
                            scanf("%f", &valor);

                            if(valor > 0 && valor <= limite) {
                                c[id].saldo[0] += valor;
                                c[id].emprestimo = 1;
                                sprintf(c[id].historico, "Emprestimo");
                            }
                        } else printf("Nao apto ao emprestimo!\n");
                    }

                    else if(acao == 4) {
                        if(c[id].conta[1] && c[id].saldo[1] >= 1000 &&
                           c[id].saldo[1] <= 1500 && !c[id].titulo) {
                            c[id].titulo = 1;
                            sprintf(c[id].historico, "Titulo adquirido");
                        } else printf("Nao apto ao titulo!\n");
                    }
                }
            } while(acao != 0);
            break;

        case 2:
            if(!aberto) {
                printf("Banco fechado!\n");
                break;
            }

            valor = 0;
            for(i = 0; i < n; i++)
                valor += total(c[i]);

            printf("\n=== SALDO TOTAL ===\n%d clientes | R$ %.2f\n", n, valor);

            printf("\n=== APTOS A EMPRESTIMO ===\n");
            for(i = 0; i < n; i++)
                if(c[i].conta[0] && c[i].conta[2] &&
                   c[i].saldo[2] > 0 && !c[i].emprestimo)
                    printf("%s | %d-01 | R$ %.2f\n", c[i].nome,
                    c[i].numero[0], total(c[i]) * 2.5);

            printf("\n=== SALDO NEGATIVO ===\n");
            for(i = 0; i < n; i++)
                if(c[i].saldo[0] < 0)
                    printf("%s | R$ %.2f\n", c[i].nome, c[i].saldo[0]);

            printf("\n=== APTOS A TITULOS ===\n");
            for(i = 0; i < n; i++)
                if(c[i].conta[1] && c[i].saldo[1] >= 1000 &&
                   c[i].saldo[1] <= 1500 && !c[i].titulo)
                    printf("%s | %d-02 | R$ %.2f\n", c[i].nome,
                    c[i].numero[1], c[i].saldo[1]);

            printf("\n=== HISTORICO DOS CLIENTES ===\n");
            for(i = 0; i < n; i++)
                printf("%s: %s\n", c[i].nome, c[i].historico);
            break;

        case 3:
            if(!aberto) {
                printf("Banco fechado!\n");
                break;
            }

            if(n < 5) {
                printf("Necessarios 5 clientes!\n");
                break;
            }

            for(i = 0; i < n; i++) ordem[i] = i;

            for(i = 0; i < n-1; i++)
                for(j = i+1; j < n; j++)
                    if(total(c[ordem[j]]) > total(c[ordem[i]])) {
                        temp = ordem[i];
                        ordem[i] = ordem[j];
                        ordem[j] = temp;
                    }

            for(i = 0; i < 5; i++)
                if(!c[ordem[i]].titulo) break;

            if(i < 5) {
                printf("Os cinco maiores saldos precisam de titulo!\n");
                break;
            }

            a = 0;
            b = 1;
            for(i = 0; i < rand() % 10 + 1; i++) {
                temp = a + b;
                a = b;
                b = temp;
            }

            id = ordem[b % 5];
            tipo = -1;

            for(j = 0; j < 3; j++)
                if(c[id].conta[j] &&
                   (tipo == -1 || c[id].saldo[j] > c[id].saldo[tipo]))
                    tipo = j;

            premio = c[id].saldo[tipo] * 10;
            c[id].saldo[tipo] += premio;

            printf("\nVENCEDOR: %s\nPremio: R$ %.2f\n",
                   c[id].nome, premio);
            sprintf(c[id].historico, "Ganhou o sorteio");
            break;

        case 0:
            printf("Banco encerrado!\n");
            break;

        default:
            printf("Opcao invalida!\n");
        }

    } while(op != 0);

    return 0;
}
          
